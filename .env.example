# =============================================================================
# App
# =============================================================================
APP_ENV=local
API_KEY=change-me-in-production
LOG_LEVEL=INFO

# =============================================================================
# AWS region（S3 / OpenSearch 用；凭证用 AWS_PROFILE 或 aws configure，不写进这里）
# =============================================================================
AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile

# =============================================================================
# SEC EDGAR（ingest 下载必填）
# =============================================================================
SEC_COMPANY_NAME=Your Name or University
SEC_COMPANY_EMAIL=you@example.com

# =============================================================================
# Retrieval — pgvector + embedding（Phase 1+）
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rag_db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# local = Docker pgvector（默认）；opensearch = Phase 4 云索引
VECTOR_BACKEND=local
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=384

# =============================================================================
# S3（Phase 4 Step 2+）
# =============================================================================
# Create bucket in AWS console first — real lowercase name, NOT tutorial placeholder text
S3_BUCKET=kelly-sec-rag-filings-2026
S3_PREFIX=filings

# =============================================================================
# OpenSearch Serverless（Phase 4 Step 3+）
# =============================================================================
OPENSEARCH_ENDPOINT=https://xxxxxxxx.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX=sec-chunks

# =============================================================================
# LLM — Bedrock Mantle（Phase 2+；当前 generation 路径）
# =============================================================================
LLM_PROVIDER=mantle
MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
MANTLE_API_KEY=your-bedrock-api-key-from-mantle-console
MANTLE_MODEL_ID=qwen.qwen3-coder-next
# MANTLE_MAX_TOKENS=1024
# MANTLE_TIMEOUT_SECONDS=60

# =============================================================================
# Classic bedrock-runtime（future — Support / 公司账号开通后）
# =============================================================================
# LLM_PROVIDER=bedrock
# BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
