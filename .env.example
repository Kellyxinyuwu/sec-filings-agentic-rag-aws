# App
APP_ENV=local
API_KEY=change-me-in-production
LOG_LEVEL=INFO

# AWS (Phase 2+)
AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile

# Bedrock (Phase 2+)
# BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# OpenSearch / S3 (Phase 4+)
# OPENSEARCH_ENDPOINT=
# S3_BUCKET=

# SEC EDGAR (required for downloads — use real name/email)
SEC_COMPANY_NAME=Your Name or University
SEC_COMPANY_EMAIL=you@example.com

# --- Phase 1: local pgvector (port 5433 = docker-compose in Step 2) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rag_db
EMBEDDING_MODEL=all-MiniLM-L6-v2


# --- Phase 2: LLM (Bedrock Mantle — OpenAI-compatible) ---
# Provider: mantle | bedrock | ollama (Phase 2 implements mantle first)
LLM_PROVIDER=mantle

# Mantle endpoint — must include /v1 (OpenAI SDK appends /chat/completions)
# us-east-1 example; swap region if needed
MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
MANTLE_API_KEY=your-bedrock-api-key-from-mantle-console

# Copy exact ID from Mantle Console → Evaluate (e.g. Qwen3 Coder Next)
MANTLE_MODEL_ID=qwen.qwen3-coder-next

# Optional tuning (Step 2+)
# MANTLE_MAX_TOKENS=1024
# MANTLE_TIMEOUT_SECONDS=60

# Classic bedrock-runtime (Support 通过后 — Step 2+ optional)
# LLM_PROVIDER=bedrock
# BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
